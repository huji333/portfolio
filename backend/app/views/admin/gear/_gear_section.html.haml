-# カメラ・レンズ共通の機材テーブル。パスは polymorphic_path で両モデルに対応する。
-# show_manufacturer が true のときだけメーカー列を出す（カメラのみ）。
%section.mb-5
  .d-flex.justify-content-between.align-items-center.mb-2
    %h2.h4.mb-0= title
    = link_to '新規作成', new_polymorphic_path([:admin, model_class]), class: 'btn btn-primary btn-sm'
  .table-responsive
    %table.table.table-striped
      %thead
        %tr
          %th 表示名
          - if show_manufacturer
            %th メーカー
          %th.text-end 使用枚数
          %th 状態
          %th 操作
      %tbody
        - records.each do |record|
          %tr
            %td= record.name
            - if show_manufacturer
              %td= record.manufacturer
            %td.text-end= usage[record.id] || 0
            %td
              - if record.uncurated?
                %span.badge.text-bg-warning 未整備
              - else
                %span.text-muted —
            %td
              .d-flex.gap-1
                = link_to '編集', edit_polymorphic_path([:admin, record]), class: 'btn btn-secondary btn-sm'
                = button_to '削除', polymorphic_path([:admin, record]), method: :delete, data: { turbo_confirm: '本当に削除しますか？' }, class: 'btn btn-danger btn-sm'
