%tr.cursor-pointer{"data-image-id": image.id}
  %td
    = link_to edit_admin_image_path(image), class: 'd-block' do
      = render 'admin/images/image_preview', image: image
  %td
    = link_to edit_admin_image_path(image), class: 'text-decoration-none' do
      = render 'admin/images/image_title', image: image
  %td= render 'admin/images/status_badge', image: image
