%h1 画像詳細
- if @image.file.attached?
  .mb-3
    = image_tag @image.thumbnail_variant, class: 'img-fluid img-thumbnail admin-thumb-show'
- else
  %p.text-muted No image attached.
.row.py-1
  .col-md-3.fw-bold Title
  .col-md-9= @image.title
.row.py-1
  .col-md-3.fw-bold Caption
  .col-md-9= @image.caption
.row.py-1
  .col-md-3.fw-bold Taken at
  .col-md-9= @image.taken_at
.row.py-1
  .col-md-3.fw-bold Camera
  .col-md-9= @image.camera&.name
.row.py-1
  .col-md-3.fw-bold Lens
  .col-md-9= @image.lens&.name
.row.py-1
  .col-md-3.fw-bold 公開状態
  .col-md-9= render 'admin/images/status_badge', image: @image

= link_to '編集', edit_admin_image_path(@image)
\|
= link_to '戻る', admin_images_path
